{
  "name": "wp-dev-toolkit",
  "version": "1.0.0",
  "description": "A comprehensive toolkit for WordPress plugin development with React-based admin interface, debugging tools, and developer utilities",
  "author": "Mr Alamin Ahamed <contact@mralaminahamed.com> (https://mralaminahamed.com)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/mralaminahamed/wp-dev-toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mralaminahamed/wp-dev-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/mralaminahamed/wp-dev-toolkit/issues"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "development",
    "toolkit",
    "react",
    "debugging",
    "developer-tools"
  ],
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "wp-scripts test-unit-js",
    "prepare": "husky install",
    "dev": "concurrently \"npm:start\" \"npm:check-types -- --watch\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@types/react-router-dom": "^5.3.3",
    "@types/wordpress__api-fetch": "^3.23.1",
    "@types/wordpress__components": "^23.8.0",
    "@types/wordpress__element": "^2.14.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@wordpress/eslint-plugin": "^22.15.0",
    "@wordpress/scripts": "^30.22.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.6.2",
    "sass-loader": "^16.0.5",
    "scss": "^0.2.4",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@wordpress/api-fetch": "^7.29.0",
    "@wordpress/components": "^30.2.0",
    "@wordpress/data": "^10.29.0",
    "@wordpress/element": "^6.29.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "yarn@4.9.2",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}
