{
  "name": "wp-dev-toolkit",
  "version": "1.0.0",
  "description": "A comprehensive toolkit for WordPress plugin development with React-based admin interface, debugging tools, and developer utilities",
  "author": "A-Amin Ahamed <contact@mralaminahamed.com> (https://alaminahamed.com)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/mralaminahamed/wp-dev-toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mralaminahamed/wp-dev-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/mralaminahamed/wp-dev-toolkit/issues"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "development",
    "toolkit",
    "react",
    "debugging",
    "developer-tools"
  ],
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "wp-scripts test-unit-js",
    "prepare": "husky install",
    "dev": "concurrently \"npm:start\" \"npm:check-types -- --watch\""
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/babel__core": "^7",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/wordpress__api-fetch": "^3.23.1",
    "@types/wordpress__components": "^23.8.0",
    "@types/wordpress__element": "^2.14.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@wordpress/eslint-plugin": "^23.0.0",
    "@wordpress/scripts": "^31.2.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.8.0",
    "sass-loader": "^16.0.6",
    "scss": "^0.2.4",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "terser-webpack-plugin": "^5.3.16",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@wordpress/api-fetch": "^7.37.0",
    "@wordpress/components": "^31.0.0",
    "@wordpress/data": "^10.37.0",
    "@wordpress/element": "^6.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.12.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}
