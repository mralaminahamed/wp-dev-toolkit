{
  "name": "wp-dev-toolkit",
  "version": "1.0.0",
  "description": "WordPress Development Toolkit with React-based control panel",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "wp-scripts test-unit-js"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/wordpress__api-fetch": "^3.23.1",
    "@types/wordpress__components": "^23.8.0",
    "@types/wordpress__element": "^2.14.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@wordpress/scripts": "^30.18.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "css-loader": "^7.1.2",
    "eslint": "8",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.6.0",
    "react-router": "^7.6.2",
    "sass-loader": "^16.0.5",
    "scss": "^0.2.4",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@wordpress/api-fetch": "^7.25.0",
    "@wordpress/components": "^29.11.0",
    "@wordpress/data": "^10.25.0",
    "@wordpress/element": "^6.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "packageManager": "yarn@4.9.2"
}
