includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5
	
	paths:
		- includes/
		- wp-dev-toolkit.php
	
	excludePaths:
		- vendor/
		- node_modules/
		- build/
		- tests/
	
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	
	stubFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	
	
	
	# Error reporting
	reportUnmatchedIgnoredErrors: false
	
	# Ignore common WordPress patterns
	ignoreErrors:
		# WordPress functions that are defined conditionally
		- '#Function [a-zA-Z_]+\(\) not found\.#'
		
		# WordPress constants that may not be defined during analysis
		- '#Constant [A-Z_]+ not found\.#'
		
		# WordPress globals that may not be available
		- '#Variable \$[a-zA-Z_]+ might not be defined\.#'
		
		# Common WordPress patterns
		- '#Cannot call method [a-zA-Z_]+\(\) on mixed\.#'
		
		# WordPress hook system patterns
		- '#Parameter .* of function (add_action|add_filter|do_action|apply_filters) expects .*, .* given\.#'
		
		# WordPress REST API patterns  
		- '#Method WP_REST_.*::.* invoked with .* parameters?, .* required\.#'
		
		# WordPress database patterns
		- '#Access to an undefined property wpdb::\$.*\.#'
		
		# Allow mixed return types for WordPress compatibility
		- '#Method .* should return .* but returns mixed\.#'
		
		# WordPress nonce and capabilities
		- '#Function (wp_verify_nonce|current_user_can) not found\.#'
		
		# WordPress sanitization functions
		- '#Function (sanitize_.*|esc_.*) not found\.#'
		
		# WordPress utility functions
		- '#Function (wp_.*|get_.*|is_.*|has_.*) not found\.#'
		
		# WordPress internationalization
		- '#Function (__|\\_\\_|_e|_x|_n|_nx|_n_noop|_nx_noop|translate_nooped_plural) not found\.#'
		
		# WordPress options and transients
		- '#Function (get_option|add_option|update_option|delete_option|get_transient|set_transient|delete_transient) not found\.#'
		
		# WordPress file system
		- '#Function (wp_upload_dir|wp_mkdir_p|WP_Filesystem) not found\.#'
		
		# WordPress admin functions
		- '#Function (add_menu_page|add_submenu_page|admin_url|menu_page_url) not found\.#'
		
		# WordPress HTTP API
		- '#Function (wp_remote_.*|wp_safe_remote_.*) not found\.#'
		
		# Allow WordPress-style array usage
		- '#Offset .* does not exist on array.*\.#'
		
		# WordPress time functions
		- '#Function (current_time|human_time_diff) not found\.#'
		
		# WordPress REST API
		- '#Function (rest_.*|register_rest_.*) not found\.#'
	
	# Dynamic analysis improvements
	dynamicConstantNames:
		- ABSPATH
		- WP_DEBUG
		- WP_CONTENT_DIR
		- WP_PLUGIN_DIR
		- WP_PLUGIN_URL
		- WPINC
		- WP_DEV_TOOLKIT_VERSION
		- WP_DEV_TOOLKIT_PLUGIN_DIR
		- WP_DEV_TOOLKIT_PLUGIN_URL
		- WP_DEV_TOOLKIT_PLUGIN_BASENAME
		- WP_DEV_TOOLKIT_ASSETS_DIR
		- WP_DEV_TOOLKIT_ASSETS_URL
		- WP_MEMORY_LIMIT
		- DAY_IN_SECONDS
		- PHP_INT_MAX
	
	# Parallel processing for better performance (reduced for memory)
	parallel:
		maximumNumberOfProcesses: 2