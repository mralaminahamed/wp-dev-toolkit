{
  "name": "mralaminahamed/wp-dev-toolkit",
  "description": "A comprehensive toolkit for WordPress plugin development with debugging tools, performance monitoring, and developer utilities",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "plugin",
    "development",
    "toolkit",
    "debugging",
    "developer-tools"
  ],
  "homepage": "https://github.com/mralaminahamed/wp-dev-toolkit",
  "authors": [
    {
      "name": "Mr Alamin Ahamed",
      "email": "contact@mralaminahamed.com",
      "homepage": "https://mralaminahamed.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=7.4",
    "psy/psysh": "^0.12.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.6",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "php-stubs/wordpress-stubs": "^6.6",
    "php-stubs/wp-cli-stubs": "^2.10"
  },
  "autoload": {
    "psr-4": {
      "WPDevToolkit\\": "includes/"
    },
    "files": [
      "class-wp-dev-toolkit.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WPDevToolkit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse",
    "check-cs": "@phpcs",
    "fix-cs": "@phpcbf",
    "analyse": "@phpstan",
    "all": [
      "@test",
      "@check-cs",
      "@analyse"
    ],
    "post-install-cmd": [
      "@php -r \"file_exists('.git/hooks/pre-commit') || copy('resources/pre-commit', '.git/hooks/pre-commit');\""
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/mralaminahamed/wp-dev-toolkit/issues",
    "source": "https://github.com/mralaminahamed/wp-dev-toolkit"
  }
}
