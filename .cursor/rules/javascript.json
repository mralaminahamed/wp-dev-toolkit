{
  "formatter": {
    "indentSize": 2,
    "useTabs": false,
    "lineWidth": 200,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "semi": true
  },
  "organizeImports": {
    "enabled": true,
    "groupImports": true
  },
  "linter": {
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "warn",
      "no-undef": "error",
      "eqeqeq": "error",
      "no-var": "error",
      "prefer-const": "warn",
      "no-multiple-empty-lines": ["error", { "max": 1 }],
      "quotes": ["error", "single"],
      "semi": ["error", "always"]
    }
  },
  "patterns": [
    {
      "name": "WordPress AJAX Request",
      "description": "Create a WordPress AJAX request",
      "pattern": "jQuery.ajax({\n  url: ajaxurl,\n  type: 'POST',\n  data: {\n    action: '${1:action_name}',\n    nonce: wp_dev_toolkit.nonce,\n    ${2:key}: ${3:value}\n  },\n  success: function(response) {\n    $0\n  },\n  error: function(xhr, status, error) {\n    console.error('AJAX Error:', error);\n  }\n});"
    },
    {
      "name": "WordPress DOM Ready",
      "description": "Create a WordPress DOM ready function",
      "pattern": "jQuery(document).ready(function($) {\n  $0\n});"
    },
    {
      "name": "WordPress Localized Script",
      "description": "Access WordPress localized script data",
      "pattern": "const { ${1:variable} } = wp_dev_toolkit_data;\n$0"
    },
    {
      "name": "Event Listener",
      "description": "Add an event listener",
      "pattern": "${1:document}.addEventListener('${2|click,change,submit,input,keyup,load|}', function(event) {\n  $0\n});"
    }
  ]
} 